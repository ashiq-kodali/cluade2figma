{
  "manifest_version": 3,
  "name": "Claude Design → Figma",
  "version": "1.0.0",
  "description": "Pick any frame in Claude Design, copy it, and paste it straight into Figma with ⌘V.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Claude Design → Figma",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "offscreen", "clipboardWrite"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://*.claudeusercontent.com/*",
    "https://*.claude.site/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://*.claudeusercontent.com/*",
        "https://*.claude.site/*"
      ],
      "js": [
        "content/ns.js",
        "lib/image.js",
        "content/serialize.js",
        "content/to-svg.js",
        "content/frames.js",
        "content/picker.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "start-picker": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Pick a frame to copy to Figma"
    }
  }
}
